{
  "name": "conda-assistant",
  "displayName": "CondaAssistant",
  "description": "智能 Conda 环境助手",
  "version": "0.1.0",
  "publisher": "pushtracer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PushTracer/CondaAssistant"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "conda",
    "python",
    "ai",
    "deep learning",
    "cuda",
    "environment"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:condaEnvironments",
    "onCommand:conda-assistant.createEnvironment",
    "onCommand:conda-assistant.healthCheck",
    "onCommand:conda-assistant.quickCreate"
  ],
  "main": "./out/src/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "conda-assistant-sidebar",
          "title": "Conda AI Manager",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "conda-assistant-sidebar": [
        {
          "type": "tree",
          "id": "condaEnvironments",
          "name": "Conda 环境"
        },
        {
          "type": "tree",
          "id": "condaQuickActions",
          "name": "快速操作"
        }
      ]
    },
    "commands": [
      {
        "command": "conda-assistant.refresh",
        "title": "刷新环境列表"
      },
      {
        "command": "conda-assistant.createEnvironment",
        "title": "创建环境..."
      },
      {
        "command": "conda-assistant.deleteEnvironment",
        "title": "删除环境"
      },
      {
        "command": "conda-assistant.activateEnvironment",
        "title": "激活环境"
      },
      {
        "command": "conda-assistant.quickCreate",
        "title": "AI 环境一键创建"
      },
      {
        "command": "conda-assistant.healthCheck",
        "title": "AI 环境健康检查"
      },
      {
        "command": "conda-assistant.analyzeEnvironment",
        "title": "环境分析"
      },
      {
        "command": "conda-assistant.exportEnvironment",
        "title": "一键备份环境"
      },
      {
        "command": "conda-assistant.importEnvironment",
        "title": "一键恢复环境"
      },
      {
        "command": "conda-assistant.selectInterpreter",
        "title": "切换 Python 解释器"
      },
      {
        "command": "conda-assistant.installPackage",
        "title": "安装包"
      },
      {
        "command": "conda-assistant.uninstallPackage",
        "title": "卸载包"
      },
      {
        "command": "conda-assistant.showPackageDeps",
        "title": "查看依赖"
      },
      {
        "command": "conda-assistant.cloneEnvironment",
        "title": "克隆环境"
      },
      {
        "command": "conda-assistant.renameEnvironment",
        "title": "重命名环境"
      },
      {
        "command": "conda-assistant.detectConflict",
        "title": "检测依赖冲突"
      },
      {
        "command": "conda-assistant.scanWSL",
        "title": "扫描 WSL Conda 环境"
      },
      {
        "command": "conda-assistant.openWSLTerminal",
        "title": "打开 WSL 终端"
      },
      {
        "command": "conda-assistant.diskDiagnose",
        "title": "磁盘空间诊断"
      },
      {
        "command": "conda-assistant.cleanCache",
        "title": "清理缓存（Conda / pip）"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "conda-assistant.refresh",
          "when": "view == condaEnvironments",
          "group": "navigation"
        },
        {
          "command": "conda-assistant.createEnvironment",
          "when": "view == condaEnvironments",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "conda-assistant.activateEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv",
          "group": "inline"
        },
        {
          "command": "conda-assistant.analyzeEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv",
          "group": "inline"
        },
        {
          "command": "conda-assistant.deleteEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        },
        {
          "command": "conda-assistant.exportEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        },
        {
          "command": "conda-assistant.cloneEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        },
        {
          "command": "conda-assistant.renameEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        },
        {
          "command": "conda-assistant.installPackage",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        },
        {
          "command": "conda-assistant.uninstallPackage",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        }
      ]
    },
    "configuration": {
      "title": "Conda AI Manager",
      "properties": {
        "conda-assistant.condaPath": {
          "type": "string",
          "default": "",
          "description": "Conda 可执行文件路径（留空自动检测）"
        },
        "conda-assistant.autoDetectConda": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动检测 Conda"
        },
        "conda-assistant.defaultPythonVersion": {
          "type": "string",
          "default": "3.12",
          "description": "创建环境时的默认 Python 版本"
        },
        "conda-assistant.healthCheckOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动进行环境健康检查"
        },
        "conda-assistant.showInactiveEnvironments": {
          "type": "boolean",
          "default": true,
          "description": "显示非激活环境"
        },
        "conda-assistant.enableWSLSupport": {
          "type": "boolean",
          "default": true,
          "description": "启用 WSL Conda 检测"
        },
        "conda-assistant.condaInstallTimeout": {
          "type": "number",
          "default": 600000,
          "description": "Conda 安装超时时间（毫秒，默认 10 分钟）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "tslint -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.2",
    "vsce": "^2.15.0",
    "@vscode/test-electron": "^2.3.8",
    "mocha": "^10.2.0"
  }
}
