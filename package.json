{
  "name": "conda-assistant",
  "displayName": "CondaAssistant",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "pushtracer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PushTracer/CondaAssistant"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "conda",
    "python",
    "ai",
    "deep learning",
    "cuda",
    "environment"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:condaEnvironments",
    "onView:condaQuickActions"
  ],
  "main": "./out/src/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "conda-assistant-sidebar",
          "title": "Conda AI Manager",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "conda-assistant-sidebar": [
        {
          "type": "tree",
          "id": "condaEnvironments",
          "name": "%view.environments%"
        },
        {
          "type": "tree",
          "id": "condaQuickActions",
          "name": "%view.quickActions%"
        }
      ]
    },
    "commands": [
      {
        "command": "conda-assistant.refresh",
        "title": "%command.refresh%"
      },
      {
        "command": "conda-assistant.createEnvironment",
        "title": "%command.createEnvironment%"
      },
      {
        "command": "conda-assistant.deleteEnvironment",
        "title": "%command.deleteEnvironment%"
      },
      {
        "command": "conda-assistant.activateEnvironment",
        "title": "%command.activateEnvironment%"
      },
      {
        "command": "conda-assistant.quickCreate",
        "title": "%command.quickCreate%"
      },
      {
        "command": "conda-assistant.healthCheck",
        "title": "%command.healthCheck%"
      },
      {
        "command": "conda-assistant.pytorchTest",
        "title": "%command.pytorchTest%"
      },
      {
        "command": "conda-assistant.analyzeEnvironment",
        "title": "%command.analyzeEnvironment%"
      },
      {
        "command": "conda-assistant.selectInterpreter",
        "title": "%command.selectInterpreter%"
      },
      {
        "command": "conda-assistant.switchInterpreter",
        "title": "%command.switchInterpreter%"
      },
      {
        "command": "conda-assistant.installPackage",
        "title": "%command.installPackage%"
      },
      {
        "command": "conda-assistant.uninstallPackage",
        "title": "%command.uninstallPackage%"
      },
      {
        "command": "conda-assistant.showPackageDeps",
        "title": "%command.showPackageDeps%"
      },
      {
        "command": "conda-assistant.cloneEnvironment",
        "title": "%command.cloneEnvironment%"
      },
      {
        "command": "conda-assistant.renameEnvironment",
        "title": "%command.renameEnvironment%"
      },
      {
        "command": "conda-assistant.detectConflict",
        "title": "%command.detectConflict%"
      },
      {
        "command": "conda-assistant.scanWSL",
        "title": "%command.scanWSL%"
      },
      {
        "command": "conda-assistant.openWSLTerminal",
        "title": "%command.openWSLTerminal%"
      },
      {
        "command": "conda-assistant.diskDiagnose",
        "title": "%command.diskDiagnose%"
      },
      {
        "command": "conda-assistant.cleanCache",
        "title": "%command.cleanCache%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "conda-assistant.refresh",
          "when": "view == condaEnvironments",
          "group": "navigation"
        },
        {
          "command": "conda-assistant.createEnvironment",
          "when": "view == condaEnvironments",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "conda-assistant.activateEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv",
          "group": "inline"
        },
        {
          "command": "conda-assistant.analyzeEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv",
          "group": "inline"
        },
        {
          "command": "conda-assistant.deleteEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        },
        {
          "command": "conda-assistant.cloneEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        },
        {
          "command": "conda-assistant.renameEnvironment",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        },
        {
          "command": "conda-assistant.installPackage",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        },
        {
          "command": "conda-assistant.uninstallPackage",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        },
        {
          "command": "conda-assistant.pytorchTest",
          "when": "view == condaEnvironments && viewItem == condaEnv"
        }
      ]
    },
    "configuration": {
      "title": "Conda AI Manager",
      "properties": {
        "conda-assistant.condaPath": {
          "type": "string",
          "default": "",
          "description": "%config.condaPath.description%"
        },
        "conda-assistant.autoDetectConda": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoDetectConda.description%"
        },
        "conda-assistant.defaultPythonVersion": {
          "type": "string",
          "default": "3.12",
          "description": "%config.defaultPythonVersion.description%"
        },
        "conda-assistant.healthCheckOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.healthCheckOnStartup.description%"
        },
        "conda-assistant.showInactiveEnvironments": {
          "type": "boolean",
          "default": true,
          "description": "%config.showInactiveEnvironments.description%"
        },
        "conda-assistant.enableWSLSupport": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableWSLSupport.description%"
        },
        "conda-assistant.condaInstallTimeout": {
          "type": "number",
          "default": 600000,
          "description": "%config.condaInstallTimeout.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "tsc --noEmit -p ./",
    "l10n:check": "npm run compile && node ./scripts/verify-l10n.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.2",
    "vsce": "^2.15.0",
    "@vscode/test-electron": "^2.3.8",
    "mocha": "^10.2.0"
  }
}
